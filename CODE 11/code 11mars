<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Color Run - Montpellier</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <style>
        :root { --blue: #0b57d0; --green: #4caf50; --pink: #ff007f; --dark: #121212; --glass: rgba(25, 25, 25, 0.95); }
        body { margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; background: var(--dark); color: white; overflow: hidden; }
        #map { height: 100vh; width: 100vw; z-index: 1; }

        /* --- AUTH --- */
        #auth-screen { position: fixed; inset: 0; z-index: 9999; background: linear-gradient(135deg, var(--pink) 0%, #000 100%); display: flex; align-items: center; justify-content: center; }
        .auth-card { background: var(--glass); padding: 30px; border-radius: 25px; width: 85%; max-width: 350px; text-align: center; backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1); }
        input { width: 100%; padding: 14px; border-radius: 12px; border: 1px solid #333; background: #1a1a1a; color: white; margin-bottom: 15px; box-sizing: border-box; font-size: 16px; }
        .btn-main { width: 100%; padding: 14px; border-radius: 12px; border: none; background: var(--pink); color: white; font-weight: bold; cursor: pointer; }

        /* --- HUD & NAV --- */
        #hud { position: fixed; top: 15px; left: 15px; z-index: 1000; background: var(--glass); padding: 12px 18px; border-radius: 18px; display: none; border: 1px solid rgba(255,255,255,0.1); }
        .hud-avatar { width: 45px; height: 45px; border-radius: 50%; border: 2px solid var(--pink); margin-right: 12px; }
        #navbar { position: fixed; bottom: 0; width: 100%; height: 70px; background: var(--glass); z-index: 2000; display: none; justify-content: space-around; align-items: center; border-top: 1px solid rgba(255,255,255,0.1); }
        .nav-item { font-size: 24px; cursor: pointer; opacity: 0.4; transition: 0.3s; }
        .nav-item.active { opacity: 1; color: var(--pink); transform: scale(1.2); }

        /* --- MODALS --- */
        .modal { position: fixed; inset: 0; background: var(--dark); z-index: 3000; display: none; flex-direction: column; padding: 25px; overflow-y: auto; }
        .pass-item { background: #1a1a1a; padding: 15px; border-radius: 15px; margin-bottom: 12px; display: flex; align-items: center; border: 1px solid #333; }
        .pass-item.unlocked { border-color: var(--pink); background: rgba(255, 0, 127, 0.1); }
        .lvl-tag { background: var(--pink); padding: 5px 10px; border-radius: 8px; margin-right: 15px; font-weight: bold; font-size: 11px; }

        #startRaceBtn { position: fixed; left: 50%; bottom: 90px; transform: translateX(-50%); z-index: 1500; padding: 16px 45px; border: none; border-radius: 50px; background: var(--pink); color: white; font-weight: bold; display: none; cursor: pointer; }
    </style>
</head>
<body>

<div id="auth-screen">
    <div class="auth-card">
        <h1>COLOR <span>RUN</span></h1>
        <div id="login-inputs">
            <input type="text" id="user-name" placeholder="Pseudo">
            <input type="email" id="user-email" placeholder="Email">
            <input type="password" id="user-pass" placeholder="Mot de passe">
            <button class="btn-main" onclick="handleAuth()">C'est parti !</button>
            <p style="margin-top:15px; font-size:12px; opacity:0.6; cursor:pointer;" onclick="toggleAuthMode()" id="toggle-btn">Déjà inscrit ? Connexion</p>
        </div>
    </div>
</div>

<div id="hud">
    <div style="display: flex; align-items: center;" onclick="openModal('modal-profil')">
        <img id="hudAvatar" class="hud-avatar" src="">
        <div>
            <span style="font-weight:bold; font-size:15px;" id="displayName">Joueur</span>
            <span style="font-size:10px; color:var(--pink); display:block; font-weight:900;" id="displayRank">NÉOPHYTE</span>
            <div style="font-size:10px; opacity:0.6;">KM: <span id="displayKm">0.00</span> | ZONES: <span id="displayZones">0</span></div>
        </div>
    </div>
</div>

<button id="startRaceBtn">LANCER COLOR RUN</button>

<div id="navbar">
    <div class="nav-item active" id="nav-map" onclick="closeModals()">🗺️</div>
    <div class="nav-item" id="nav-pass" onclick="openModal('modal-pass')">🏆</div>
    <div class="nav-item" id="nav-profil" onclick="openModal('modal-profil')">👤</div>
</div>

<div id="modal-pass" class="modal">
    <div style="display:flex; justify-content:space-between;"><h2>Color Pass</h2><span onclick="closeModals()" style="font-size:35px;">&times;</span></div>
    <div id="pass-list"></div>
</div>

<div id="modal-profil" class="modal">
    <div style="display:flex; justify-content:space-between;"><h2>Mon Profil</h2><span onclick="closeModals()" style="font-size:35px;">&times;</span></div>
    <div style="text-align:center;">
        <img id="profAvatar" src="" style="width:100px; border-radius:50%; border:3px solid var(--pink);">
        <h2 id="profName">Pseudo</h2>
        <p id="profEmail" style="opacity:0.5;"></p>
        <button class="btn-main" style="background:#444; margin-top:20px;" onclick="location.reload()">Déconnexion</button>
    </div>
</div>

<div id="map"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let map, userMarker, pathLine, running = false, isLoginMode = false, currentUser = null;
    let currentPathColor = "#ff007f";

    const TITLES = [
        { lvl: 1, name: "NÉOPHYTE DU PEYROU" },
        { lvl: 3, name: "MARCHEUR DU LEZ" },
        { lvl: 5, name: "TROTTEUR D'ANTIGONE" },
        { lvl: 10, name: "SPRINTEUR DE LA COMÉDIE" },
        { lvl: 25, name: "MAÎTRE DE MONTPELLIER" }
    ];

    function toggleAuthMode() {
        isLoginMode = !isLoginMode;
        document.getElementById('user-name').style.display = isLoginMode ? "none" : "block";
        document.getElementById('btn-auth-action').textContent = isLoginMode ? "Se connecter" : "C'est parti !";
    }

    function handleAuth() {
        const email = document.getElementById('user-email').value;
        const pass = document.getElementById('user-pass').value;
        const name = document.getElementById('user-name').value;

        if(isLoginMode) {
            let saved = JSON.parse(localStorage.getItem(`cr_${email}`));
            if(saved && saved.pass === pass) currentUser = saved;
            else return alert("Erreur");
        } else {
            currentUser = { email, name, pass, level: 1, kmTotal: 0, zones: 0 };
            localStorage.setItem(`cr_${email}`, JSON.stringify(currentUser));
        }
        document.getElementById('auth-screen').style.display = "none";
        document.getElementById('hud').style.display = "block";
        document.getElementById('navbar').style.display = "flex";
        document.getElementById('startRaceBtn').style.display = "block";
        initMap();
        updateUI();
    }

    function updateUI() {
        let title = TITLES[0].name;
        TITLES.forEach(t => { if(currentUser.level >= t.lvl) title = t.name; });
        document.getElementById('displayName').textContent = currentUser.name;
        document.getElementById('displayRank').textContent = title;
        document.getElementById('displayKm').textContent = currentUser.kmTotal.toFixed(2);
        document.getElementById('displayZones').textContent = currentUser.zones;
        document.getElementById('profName').textContent = currentUser.name;
        document.getElementById('profEmail').textContent = currentUser.email;
        let av = `https://api.dicebear.com/7.x/avataaars/svg?seed=${currentUser.name}`;
        document.getElementById('hudAvatar').src = av;
        document.getElementById('profAvatar').src = av;
        renderPass();
        localStorage.setItem(`cr_${currentUser.email}`, JSON.stringify(currentUser));
    }

    function renderPass() {
        const list = document.getElementById('pass-list');
        list.innerHTML = "";
        TITLES.forEach(t => {
            let ok = currentUser.level >= t.lvl;
            list.innerHTML += `<div class="pass-item ${ok?'unlocked':''}">
                <div class="lvl-tag">LVL ${t.lvl}</div><div style="flex:1">${t.name}</div><div>${ok?'✅':'🔒'}</div>
            </div>`;
        });
    }

    function initMap() {
        map = L.map('map', { zoomControl: false, attributionControl: false }).setView([43.611, 3.877], 15);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png').addTo(map);
        
        navigator.geolocation.watchPosition(pos => {
            const { latitude: lat, longitude: lng } = pos.coords;
            if(!userMarker) {
                userMarker = L.circleMarker([lat, lng], {radius:10, color:"#fff", fillColor: "var(--pink)", fillOpacity:1, weight:3}).addTo(map);
                map.setView([lat, lng], 17);
            } else userMarker.setLatLng([lat, lng]);

            if(running) {
                let pts = pathLine.getLatLngs();
                if(pts.length > 0) {
                    let last = pts[pts.length-1];
                    let d = map.distance(last, [lat, lng]) / 1000;
                    if(d > 0.005) {
                        currentUser.kmTotal += d;
                        currentUser.level = Math.floor(currentUser.kmTotal) + 1;
                        updateUI();
                        
                        // --- DÉTECTION DES ZONES ---
                        if(pts.length > 10) {
                            let distToStart = map.distance(pts[0], [lat, lng]);
                            if(distToStart < 20) { // Si on revient à moins de 20m du début
                                L.polygon(pts, {color: currentPathColor, fillOpacity: 0.3}).addTo(map);
                                currentUser.zones++;
                                pathLine.setLatLngs([]); // Reset le tracé actuel
                                updateUI();
                            }
                        }
                    }
                }
                pathLine.addLatLng([lat, lng]);
            }
        }, null, {enableHighAccuracy: true});
    }

    document.getElementById('startRaceBtn').onclick = function() {
        running = !running;
        this.textContent = running ? "ARRÊTER" : "LANCER COLOR RUN";
        this.style.background = running ? "red" : "var(--pink)";
        if(running) {
            currentPathColor = `hsl(${Math.random() * 360}, 80%, 60%)`;
            pathLine = L.polyline([], {color: currentPathColor, weight: 6}).addTo(map);
        }
    };

    function openModal(id) { 
        closeModals(); document.getElementById(id).style.display = "flex"; 
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        if(id === 'modal-pass') document.getElementById('nav-pass').classList.add('active');
        if(id === 'modal-profil') document.getElementById('nav-profil').classList.add('active');
    }
    function closeModals() { 
        document.querySelectorAll('.modal').forEach(m => m.style.display = "none"); 
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        document.getElementById('nav-map').classList.add('active');
    }
</script>
</body>
</html>
