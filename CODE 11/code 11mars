<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Cercle Montpellier - Connexion</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <style>
        :root { --blue: #0b57d0; --green: #4caf50; --dark: #121212; --glass: rgba(30, 30, 30, 0.9); }
        body { margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; background: var(--dark); color: white; overflow: hidden; }
        #map { height: 100vh; width: 100vw; z-index: 1; }

        /* --- ÉCRAN D'AUTH --- */
        #auth-screen {
            position: fixed; inset: 0; z-index: 9999;
            background: linear-gradient(135deg, #0b57d0 0%, #000 100%);
            display: flex; align-items: center; justify-content: center;
        }
        .auth-card {
            background: var(--glass); padding: 30px; border-radius: 25px;
            width: 85%; max-width: 350px; text-align: center; backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .auth-card h1 { margin-top: 0; font-size: 26px; }
        input { 
            width: 100%; padding: 14px; border-radius: 12px; border: 1px solid #444; 
            background: #222; color: white; margin-bottom: 15px; box-sizing: border-box;
        }
        .btn-main { 
            width: 100%; padding: 14px; border-radius: 12px; border: none; 
            background: var(--blue); color: white; font-weight: bold; cursor: pointer; font-size: 16px;
        }
        .auth-toggle { margin-top: 15px; font-size: 13px; color: #aaa; cursor: pointer; text-decoration: underline; }

        /* --- HUD & NAV --- */
        #hud {
            position: fixed; top: 15px; left: 15px; z-index: 1000;
            background: var(--glass); padding: 12px; border-radius: 15px; display: none;
        }
        #navbar {
            position: fixed; bottom: 0; width: 100%; height: 65px; 
            background: var(--glass); z-index: 2000; display: none; justify-content: space-around; align-items: center;
        }
        .nav-item { font-size: 22px; cursor: pointer; opacity: 0.5; }
        .nav-item.active { opacity: 1; color: var(--blue); }

        /* --- MODALS --- */
        .modal {
            position: fixed; inset: 0; background: var(--dark); z-index: 3000;
            display: none; flex-direction: column; padding: 25px;
        }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        
        #startRaceBtn {
            position: fixed; left: 50%; bottom: 85px; transform: translateX(-50%);
            z-index: 1500; padding: 15px 40px; border: none; border-radius: 50px;
            background: var(--blue); color: white; font-weight: bold; display: none;
        }
    </style>
</head>
<body>

<div id="auth-screen">
    <div class="auth-card" id="login-form">
        <h1 id="auth-title">Créer un compte</h1>
        <p id="auth-desc" style="font-size: 14px; opacity: 0.7; margin-bottom: 20px;">Rejoins le Cercle Running de Montpellier</p>
        
        <input type="text" id="user-name" placeholder="Pseudo">
        <input type="email" id="user-email" placeholder="Adresse Email">
        <input type="password" id="user-pass" placeholder="Mot de passe">
        
        <button class="btn-main" onclick="handleAuth()">S'inscrire</button>
        <p class="auth-toggle" onclick="toggleAuth()">Déjà un compte ? Se connecter</p>
    </div>
</div>

<div id="hud">
    <div style="display: flex; align-items: center;">
        <img id="hudAvatar" src="" style="width:40px; border-radius:50%; margin-right:10px; border:2px solid var(--green);">
        <div>
            <div id="hudName" style="font-weight:bold; font-size:14px;">Joueur</div>
            <div style="font-size:11px; color:var(--green);">Niveau <span id="hudLvl">1</span></div>
        </div>
    </div>
</div>

<button id="startRaceBtn">Lancer la course</button>

<div id="navbar">
    <div class="nav-item active" onclick="closeModals()">🗺️</div>
    <div class="nav-item" onclick="openModal('modal-pass')">🏆</div>
    <div class="nav-item" onclick="openModal('modal-profil')">👤</div>
</div>

<div id="modal-profil" class="modal">
    <div class="modal-header"><h2>Mon Compte</h2><span onclick="closeModals()" style="font-size:30px;">&times;</span></div>
    <div style="text-align:center;">
        <img id="profAvatar" src="" style="width:100px; border-radius:50%; border:3px solid var(--blue);">
        <h3 id="profName">Pseudo</h3>
        <p id="profEmail" style="opacity:0.6;">email@test.com</p>
        <hr style="border:0.5px solid #333; margin:20px 0;">
        <button class="btn-main" style="background:#444;" onclick="logout()">Se déconnecter</button>
    </div>
</div>

<div id="modal-pass" class="modal">
    <div class="modal-header"><h2>Run Pass</h2><span onclick="closeModals()" style="font-size:30px;">&times;</span></div>
    <div id="pass-content">
        </div>
</div>

<div id="map"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let map, userMarker, pathLine, running = false;
    let isLoginMode = false;
    
    // Notre "Base de données" locale
    let currentUser = null;

    function toggleAuth() {
        isLoginMode = !isLoginMode;
        document.getElementById('auth-title').textContent = isLoginMode ? "Connexion" : "Créer un compte";
        document.getElementById('user-name').style.display = isLoginMode ? "none" : "block";
        document.querySelector('.btn-main').textContent = isLoginMode ? "Se connecter" : "S'inscrire";
        document.querySelector('.auth-toggle').textContent = isLoginMode ? "Pas de compte ? S'inscrire" : "Déjà un compte ? Se connecter";
    }

    function handleAuth() {
        const email = document.getElementById('user-email').value;
        const name = document.getElementById('user-name').value;
        const pass = document.getElementById('user-pass').value;

        if(!email || !pass) return alert("Remplis tous les champs !");

        if(isLoginMode) {
            // Simulation connexion
            let savedUser = JSON.parse(localStorage.getItem(`user_${email}`));
            if(savedUser && savedUser.pass === pass) {
                currentUser = savedUser;
            } else {
                return alert("Email ou mot de passe incorrect.");
            }
        } else {
            // Simulation inscription
            if(!name) return alert("Il nous faut un pseudo !");
            currentUser = { email, name, pass, level: 1, kmTotal: 0 };
            localStorage.setItem(`user_${email}`, JSON.stringify(currentUser));
        }

        loginSuccess();
    }

    function loginSuccess() {
        document.getElementById('auth-screen').style.display = "none";
        document.getElementById('hud').style.display = "block";
        document.getElementById('navbar').style.display = "flex";
        document.getElementById('startRaceBtn').style.display = "block";
        initMap();
        updateUI();
    }

    function updateUI() {
        if(!currentUser) return;
        document.getElementById('hudName').textContent = currentUser.name;
        document.getElementById('profName').textContent = currentUser.name;
        document.getElementById('profEmail').textContent = currentUser.email;
        document.getElementById('hudLvl').textContent = currentUser.level;
        let avatar = `https://api.dicebear.com/7.x/avataaars/svg?seed=${currentUser.name}`;
        document.getElementById('hudAvatar').src = avatar;
        document.getElementById('profAvatar').src = avatar;
        
        // Sauvegarde auto
        localStorage.setItem(`user_${currentUser.email}`, JSON.stringify(currentUser));
    }

    function initMap() {
        if(map) return;
        map = L.map('map', { zoomControl: false, attributionControl: false }).setView([43.611, 3.877], 15);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png').addTo(map);
        
        navigator.geolocation.watchPosition(pos => {
            const { latitude: lat, longitude: lng } = pos.coords;
            if(!userMarker) {
                userMarker = L.circleMarker([lat, lng], {radius:8, color:"#fff", fillColor:"#0b57d0", fillOpacity:1}).addTo(map);
                map.setView([lat, lng], 17);
            } else { userMarker.setLatLng([lat, lng]); }

            if(running) {
                let points = pathLine.getLatLngs();
                if(points.length > 0) {
                    let d = map.distance(points[points.length-1], [lat, lng]) / 1000;
                    if(d > 0.005) {
                        currentUser.kmTotal += d;
                        currentUser.level = Math.floor(currentUser.kmTotal) + 1;
                        updateUI();
                    }
                }
                pathLine.addLatLng([lat, lng]);
            }
        }, null, {enableHighAccuracy: true});
    }

    document.getElementById('startRaceBtn').onclick = function() {
        running = !running;
        this.textContent = running ? "Arrêter" : "Lancer la course";
        this.style.background = running ? "red" : "var(--blue)";
        if(running) pathLine = L.polyline([], {color:'var(--blue)', weight:5}).addTo(map);
    };

    function openModal(id) { closeModals(); document.getElementById(id).style.display = "flex"; }
    function closeModals() { document.querySelectorAll('.modal').forEach(m => m.style.display = "none"); }
    function logout() { location.reload(); }
    function logout() { location.reload(); }
</script>
</body>
</html>
